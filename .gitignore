# SAM third-party (keep only license, readme, download script)
third_party/sam/*
!third_party/sam/LICENSE
!third_party/sam/README.md
!third_party/sam/download.sh

# Environment and secrets
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/
keys/

# Video/audio clips
clips/
*.mp4
*.mov
*.avi
*.mkv
*.webm

# Model weights
weights/
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx
*.engine
*.bin
*.h5
*.npz

# Generated test data
data/labels/
data/coaching_events/

# Python virtual environment and cache
.venv/
__pycache__/
*.pyc