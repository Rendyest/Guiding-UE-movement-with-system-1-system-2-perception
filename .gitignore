# Dependencies and build output
node_modules/
dist/
coverage/
*.log
.DS_Store

# Local config overrides (tuned values stay private)
config.local.json

# SAM third-party (keep only license, readme, download script)
third_party/sam/*
!third_party/sam/LICENSE
!third_party/sam/README.md
!third_party/sam/download.sh

# Environment and secrets
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/
keys/

# Video/audio clips
clips/
*.mp4
*.mov
*.avi
*.mkv
*.webm
*.wav
*.mp3
*.m4a

# Model weights
weights/
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx
*.engine
*.bin
*.h5
*.npz